{
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "basic",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none",
  "pythonVersion": "3.13",
  "include": [
    "apps",
    "config",
    "manage.py"
  ],
  "exclude": [
    "**/__pycache__",
    "**/migrations",
    "media",
    "staticfiles"
  ]
}